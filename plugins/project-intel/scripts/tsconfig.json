{
    "compilerOptions": {
        "target": "ES2023",
        "module": "commonjs",
        "lib": ["ES2023"],    
        "moduleResolution": "node",
        "outDir": "./dist",
        "rootDir": "./",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noImplicitReturns": true,
        "declaration": false,
        "declarationMap": false,
        "sourceMap": false,
        "skipLibCheck": true,
        "incremental": true,
        "allowJs": true
    },
    "include": [
        "lib/**/*",
        "types/**/*",
        "utils/**/*",
        "ctx.ts",
        "sessionstart-knowledge-check.ts"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}