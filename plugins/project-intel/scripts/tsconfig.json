{
    "compilerOptions": {
        "target": "ES2023",
        "module": "commonjs",
        "lib": [
            "ES2023"
        ],
        "outDir": "./dist",
        "rootDir": "./",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "declaration": true,
        "sourceMap": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noImplicitAny": true,
        "noImplicitThis": true
    },
    "include": [
        "lib/**/*",
        "types/**/*",
        "utils/**/*",
        "ctx.ts",
        "sessionstart-knowledge-check.ts"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}